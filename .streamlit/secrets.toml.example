# ─────────────────────────────────────────────────────────────
# Template for Streamlit Community Cloud secrets.
# DO NOT commit the real secrets.toml with values in it.
#
# On Streamlit Cloud: go to your app → ⋮ menu → Settings → Secrets,
# and paste the contents of this file (with real values) there.
# For local dev, copy this to .streamlit/secrets.toml and fill in.
# ─────────────────────────────────────────────────────────────

GOOGLE_MAPS_API_KEY = "your_google_maps_api_key_here"
ADMIN_EMAIL         = "you@example.com"
ADMIN_PASSWORD      = "a_strong_password_please"
